int* getConcatenation(int* nums, int numsSize, int* returnSize) 
{
    int newSize = 2 * numsSize;
    int* ans = (int*)malloc(newSize * sizeof(int));
    *returnSize = newSize;
    for (int i = 0; i < numsSize; i++) {
        ans[i] = nums[i];           // First half
        ans[i + numsSize] = nums[i];  // Second half
    }

    return ans;
}
